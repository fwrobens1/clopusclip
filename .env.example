# AI provider keys — copy this file to .env and fill in your own keys.
# NEVER commit your real .env file.

# Free NVIDIA NIM models (clip selection + agent). Get one at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: extra fallback provider (base URL unresolved currently)
ANYMODEL_API_KEY=
ANYMODEL_BASE_URL=https://api.anymodel.ai/v1

# Optional: Groq API for FAST parallel Whisper ASR (7h in minutes).
# Free key at https://console.groq.com — no credit card.
GROQ_API_KEY=

# Optional: Cerebras for fast LLM scripting (~1M tokens/day free).
CEREBRAS_API_KEY=

# Optional: YouTube bot-check workaround — browser name (chrome, firefox, edge...)
# YT_COOKIES_FROM_BROWSER=chrome

# Local Whisper settings
WHISPER_MODEL=tiny
WHISPER_BEAM=1
